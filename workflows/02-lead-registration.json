{
  "name": "AgencyBot - Registrar Lead v4",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length !== 1) throw new Error('Se requiere una sola entrada');\nconst input = items[0].json;\nconst clean = value => {\n  if (value === undefined || value === null) return '';\n  if (!['string', 'number', 'boolean'].includes(typeof value)) throw new Error('Valor no escalar');\n  const text = String(value).trim();\n  return text.toLowerCase() === 'null' ? '' : text;\n};\nconst lead = Object.fromEntries(Object.entries(input).map(([key, value]) => [key, clean(value)]));\nconst phone = (lead.sessionid || '').replace(/^\\+/, '');\nif (!/^[1-9][0-9]{7,14}$/.test(phone)) throw new Error('WhatsApp: telefono internacional invalido');\nlead.sessionid = phone;\nconst conversation = lead.conversation_id || '';\nif (conversation && (!/^[1-9][0-9]*$/.test(conversation) || !Number.isSafeInteger(Number(conversation)))) throw new Error('conversation_id invalido');\nlead.conversation_id = conversation;\nreturn [{ json: lead }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [800, -112],
      "id": "7a0a429f-d45b-4bf0-a460-f41481d237b3",
      "name": "Validar Entrada"
    },
    {
      "parameters": {
        "jsCode": "const lead = $('Normalizar Datos').first().json;\nconst rows = $input.all().map(item => item.json).filter(row => Object.keys(row).length > 0);\nfor (const row of rows) {\n  if (String(row.WhatsApp) !== lead.sessionid) throw new Error('WhatsApp inesperado en resultado de busqueda');\n}\nconst service = lead.servicio_interes || '';\nconst matches = service ? rows.filter(row => String(row.Servicio || '') === service) : rows;\nif (matches.length > 1) throw new Error('Lead ambiguo: multiples filas coincidentes');\nconst existing = matches[0];\nlet rowNumber;\nif (existing) {\n  const key = String(existing.row_number);\n  rowNumber = Number(key);\n  if (!/^[1-9][0-9]*$/.test(key) || !Number.isSafeInteger(rowNumber) || rowNumber < 2) throw new Error('row_number invalido');\n} else if (!service) {\n  throw new Error('servicio_interes requerido para crear lead');\n}\nconst fields = {sessionid:'WhatsApp', servicio_interes:'Servicio', nombre:'Nombre', negocio:'Negocio', giro:'Giro', ciudad:'Ciudad', tiene_web:'Tiene Web', url_web:'URL Web', segmento:'Segmento', senal_presupuesto:'Senal Presupuesto', paquete_recomendado:'Paquete Recomendado', elegible_offmenu:'Elegible Offmenu', disclosure_confirmado:'Disclosure Confirmado', etapa:'Etapa', score:'Score', etiquetas:'Etiquetas', notas:'Notas', conversation_id:'Conversation ID'};\nconst now = new Date().toISOString();\nconst row = {Fecha: existing ? String(existing.Fecha ?? '') : now, 'Followups Enviados': existing ? String(existing['Followups Enviados'] ?? '') : '0'};\nfor (const [key, column] of Object.entries(fields)) {\n  const value = lead[key];\n  const supplied = value !== undefined && value !== null && String(value).trim() !== '' && String(value).trim().toLowerCase() !== 'null';\n  row[column] = supplied ? String(value) : String(existing?.[column] ?? '');\n}\n// Merge CRM label tokens without removing existing labels. Chatwoot remains disconnected.\nif (existing && lead.etiquetas) {\n  row.Etiquetas = [...new Set((String(existing.Etiquetas ?? '') + ',' + lead.etiquetas).split(',').map(label => label.trim()).filter(Boolean))].join(',');\n}\nrow['Ultima Interaccion'] = now;\nreturn [{ json: { exists: Boolean(existing), ...(existing ? { row_number: rowNumber } : {}), row } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1200, -112],
      "id": "35406a4f-bc20-48ca-80be-49714ae53dc5",
      "name": "Resolver y Fusionar Lead"
    },
