    },
    {
      "parameters": {
        "jsCode": "// Reached only after a successful CRM write; Sheets errors stop the workflow.\nconst input = $input.all()[0].json;\nconst body = input.body ?? input;\nconst failure = input.error || body.error || (input.statusCode >= 400 ? 'CAPI HTTP error' : null);\nconst blocked = !failure && input.skip === true && input.capi_status === 'blocked';\nconst sent = !failure && body.events_received === 1;\nconst capiStatus = blocked ? 'blocked' : sent ? 'sent' : 'error';\nconst capiError = blocked ? (input.capi_error || 'integration_required') : sent ? '' : (typeof failure === 'string' ? failure : failure?.message || 'CAPI response missing or invalid');\nreturn [{ json: { status: capiStatus === 'error' ? 'partial_error' : capiStatus === 'blocked' ? 'crm_ok_capi_blocked' : 'ok', crm_status: 'ok', capi_status: capiStatus, capi_error: capiError, labels_status: 'skipped_unsafe_replace', message: 'CRM registrado/actualizado; CAPI: ' + capiStatus } }];"
      },
