    {
      "parameters": {
        "jsCode": "const lead = $('Resolver y Fusionar Lead').first().json.row;\nconst policy = $('Configuracion CAPI (confiable)').first().json;\nconst events = {nuevo: 'Lead', clasificado: 'Lead', cita_agendada: 'Schedule', llamada_agendada: 'Schedule'};\n// No payload or hashing until trusted consent and durable atomic idempotency exist.\n// A stable event_id alone does not implement durable deduplication.\nreturn [{ json: { skip: true, capi_status: 'blocked', capi_error: 'trusted_consent_and_durable_idempotency_integration_required', event_name: Object.prototype.hasOwnProperty.call(events, lead.Etapa) ? events[lead.Etapa] : '', enabled: policy.enabled === true } }];"
